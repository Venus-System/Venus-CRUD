# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore: nunca commite senhas nem chaves.

# --- Servidor ---
SERVER_PORT=8080

# --- PostgreSQL (schema venus) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- MongoDB (sessões de scan) ---
MONGO_URI=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
# Conta das fotos de usuário (avatar)
CLOUDINARY_USERS_API_KEY=
CLOUDINARY_USERS_API_SECRET=
CLOUDINARY_USERS_UPLOAD_PRESET=
# Conta das fotos de produto
CLOUDINARY_PRODUCTS_API_KEY=
CLOUDINARY_PRODUCTS_API_SECRET=
CLOUDINARY_PRODUCTS_UPLOAD_PRESET=

# --- Regras de upload de mídia ---
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_DEFAULT_DELIVERY_TYPE=upload
MEDIA_DEFAULT_RESOURCE_TYPE=image
MEDIA_AVATAR_MAX_BYTES=5242880
MEDIA_AVATAR_MAX_WIDTH=2048
MEDIA_AVATAR_MAX_HEIGHT=2048
MEDIA_PRODUCT_MAX_BYTES=10485760
MEDIA_PRODUCT_MAX_WIDTH=4096
MEDIA_PRODUCT_MAX_HEIGHT=4096

# --- Segurança ---
# Segredo do JWT do admin: no mínimo 32 bytes, senão a aplicação não sobe.
ADMIN_JWT_SECRET=
# Validade do token do admin no formato ISO-8601 (PT8H = 8 horas)
ADMIN_JWT_EXPIRATION=PT8H
# Projeto do Firebase que emite o token do app
FIREBASE_PROJECT_ID=venus-81bac
